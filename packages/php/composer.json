{
  "name": "cameronapak/platform-sdk",
  "version": "0.1.0",
  "description": "Experimental unofficial SDK for the YouVersion Platform API",
  "keywords": [
    "cameronapak",
    "api",
    "sdk"
  ],
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "php-http/discovery": "^1.0",
    "php-http/multipart-stream-builder": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Cameronapak\\PlatformSdk\\": "src/"
    }
  },
  "archive": {
    "exclude": [
      "/test",
      "/adapt.mjs",
      "/operation-map.mjs",
      "/check.mjs"
    ]
  }
}
