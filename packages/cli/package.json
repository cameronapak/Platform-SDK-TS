{
  "name": "@cameronapak/platform-cli",
  "version": "0.1.0",
  "description": "Experimental, unofficial terminal client for the YouVersion Platform API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cameronapak/Unofficial-YouVersion-Platform-SDKs.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": { "yvp": "./dist/cli.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@cameronapak/platform-sdk": "workspace:^",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "packageManager": "pnpm@12.0.0"
}
