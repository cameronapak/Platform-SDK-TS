#!/usr/bin/env bash
set -euo pipefail

# The orb already supplies Node, pnpm, uv, and Docker. Persist the missing
# toolchains so generation and consumer checks also work in fresh orbs.
if ! command -v composer >/dev/null || ! command -v unzip >/dev/null || ! php -r 'exit(extension_loaded("curl") && extension_loaded("mbstring") && extension_loaded("zip") ? 0 : 1);' 2>/dev/null; then
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq php-cli php-curl php-mbstring php-xml php-zip composer unzip
fi
php --version | head -n 1
composer --version
version=go1.27.1
if ! command -v go >/dev/null || [[ "$(go version)" != "go version $version linux/amd64" ]]; then
  archive=$(mktemp)
  trap 'rm -f "$archive"' EXIT
  curl -fsSL "https://go.dev/dl/$version.linux-amd64.tar.gz" -o "$archive"
  echo "63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445  $archive" | sha256sum --check
  sudo rm -rf /usr/local/go
  sudo tar -xzf "$archive" -C /usr/local
  sudo ln -sf /usr/local/go/bin/go /usr/local/bin/go
  sudo ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
fi
go version
if ! command -v rustup >/dev/null; then
  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.99.0
fi
source "$HOME/.cargo/env"
rustup toolchain install 1.99.0 --profile minimal --component rustfmt --component clippy
rustup default 1.99.0
for tool in cargo rustc rustfmt; do
  sudo ln -sf "$HOME/.cargo/bin/$tool" "/usr/local/bin/$tool"
done
rustc --version
pnpm install --frozen-lockfile
go -C packages/go mod download
uv sync --project packages/python --frozen --no-install-project
cargo fetch --locked --manifest-path packages/rust/Cargo.toml
cargo fetch --locked --manifest-path packages/rust/test/consumer/Cargo.toml
